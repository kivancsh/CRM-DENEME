# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you: it asks which
#  integrations you want, collects each key, and writes .env.local.
#
#  Every key here is OPTIONAL. With none set, Wholesale runs in DEMO MODE with
#  realistic sample buyers, orders and products so you can see it immediately.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (database & buyer auth) ─────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe Invoicing (invoices, net-30 terms, wholesale payments) ────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ERP / Inventory sync (products, stock levels & orders) ───────────────────
# e.g. Cin7, Katana, NetSuite — https://www.cin7.com/developers/
ERP_API_URL=
ERP_API_KEY=

# ── Resend (buyer invites, order confirmations, invoice emails) ──────────────
# https://resend.com/api-keys
RESEND_API_KEY=
